{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/session-start.sh\" ]] && exec bash \"$r/hooks/session-start.sh\"'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/session-end.sh\" ]] && exec bash \"$r/hooks/session-end.sh\"'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/pre-compact.sh\" ]] && exec bash \"$r/hooks/pre-compact.sh\"'"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/post-compact.sh\" ]] && exec bash \"$r/hooks/post-compact.sh\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/notification.sh\" ]] && exec bash \"$r/hooks/notification.sh\"'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/subagent-start.sh\" ]] && exec bash \"$r/hooks/subagent-start.sh\"'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/subagent-stop.sh\" ]] && exec bash \"$r/hooks/subagent-stop.sh\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/stop.sh\" ]] && exec bash \"$r/hooks/stop.sh\"'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/pre-tool-use.sh\" ]] && exec bash \"$r/hooks/pre-tool-use.sh\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/post-tool-use.sh\" ]] && exec bash \"$r/hooks/post-tool-use.sh\"'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'r=$(git rev-parse --show-toplevel 2>/dev/null); [[ -f \"$r/hooks/post-tool-use-failure.sh\" ]] && exec bash \"$r/hooks/post-tool-use-failure.sh\"'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "_comment": "Autonomous-by-default within the company instance. Structural safety lives in hooks/bash-policy.json (universal deny + per-role allow) + audit log + anomaly detection per handbook ADR 0004 — NOT in prompt friction. Read/Grep/Glob/WebFetch on the listed safe domains never prompt. Edit/Write inside the repo never prompt; .juvant/config.json and .env* are explicitly denied (token-bearing). Bash gating is delegated to hooks/pre-tool-use.sh. High-impact mutations (gh issue close, gh pr create, git push, turso DDL) still surface confirmation dialogs via deny_patterns + ADR 0004 Track 1.",
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(bash scripts/compile-templates.sh:*)",
      "Bash(scripts/compile-templates.sh:*)",
      "Bash(bash scripts/migrate.sh:*)",
      "Bash(scripts/migrate.sh:*)",
      "Bash(bash scripts/audit-bootstrap-baseline.sh:*)",
      "Bash(scripts/audit-bootstrap-baseline.sh:*)",
      "Bash(bash scripts/seed-matrix.sh:*)",
      "Bash(scripts/seed-matrix.sh:*)",
      "Bash(bash scripts/validate-batch-fixture.sh:*)",
      "Bash(scripts/validate-batch-fixture.sh:*)",
      "Bash(bash scripts/run-testco-batch.sh:*)",
      "Bash(scripts/run-testco-batch.sh:*)"
    ],
    "_deny_comment": "Deny on token-bearing dotenv files (explicit list — narrower than blanket .env.* which captured .env.example, a sample/template file by convention that documents required env var names). Covers standard names + common ad-hoc secret-bearing variants (secrets, private, cloud-prefixes). To extend: add patterns explicitly here, never re-broaden to .env.* or the .env.example regression returns.",
    "deny": [
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/.env.secrets)",
      "Edit(**/.env.private)",
      "Edit(**/.env.azure)",
      "Edit(**/.env.aws)",
      "Edit(**/.env.gcp)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(**/.env.development)",
      "Write(**/.env.staging)",
      "Write(**/.env.test)",
      "Write(**/.env.secrets)",
      "Write(**/.env.private)",
      "Write(**/.env.azure)",
      "Write(**/.env.aws)",
      "Write(**/.env.gcp)",
      "Edit(**/credentials*)",
      "Write(**/credentials*)"
    ]
  },
  "channels": [
    {
      "plugin": "telegram"
    }
  ]
}
